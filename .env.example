# ============================================================
# AI Hospital Alliance - Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env or .env.production to git
# ============================================================

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_ENV=development
VITE_ENABLE_MONITORING=false

# ── Backend - Application ─────────────────────────────────────
APP_ENV=development
APP_NAME=AI Hospital Assistant API
LOG_LEVEL=info
ENABLE_DOCS=true

# ── Backend - Security (REQUIRED - no defaults in production) ─
# Generate with: openssl rand -hex 64
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_64
REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_-hex_64

# ── Backend - Users (REQUIRED) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here
DOCTOR_PASSWORD=CHANGE_ME_strong_password_here
NURSE_PASSWORD=CHANGE_ME_strong_password_here
RADIOLOGY_PASSWORD=CHANGE_ME_strong_password_here

# ── Backend - Database ────────────────────────────────────────
DATABASE_URL=sqlite:///./aiha.db
# Production: postgresql://user:pass@host:5432/dbname

# ── Backend - CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── AI Providers (at least one required) ─────────────────────
GROQ_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME_optional
GOOGLE_API_KEY=CHANGE_ME_optional

# ── SaaS / Super Admin ───────────────────────────────────────────────────────
# Super admin key for tenant management (generate with: openssl rand -hex 32)
SUPER_ADMIN_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32
